[Unit]
Description=Space Health local API and React UI
After=network.target

[Service]
Type=simple
User=space-health
Group=space-health
WorkingDirectory=/opt/space-health
EnvironmentFile=/etc/space-health.env
ExecStart=/opt/space-health/bin/space-health-server
StateDirectory=space-health
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/space-health

[Install]
WantedBy=multi-user.target
