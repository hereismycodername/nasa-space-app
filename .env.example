# Rust reads shell environment variables; this file is documentation, not auto-loaded.
BIND_ADDR=127.0.0.1:8080
DATABASE_URL=sqlite://space-health.db
FRONTEND_DIST=dist
# Simulator:
API_URL=http://127.0.0.1:8080
SIM_INTERVAL_MS=2000
SIM_COUNT=0
# Synthetic test profile, not a medical alert (BE-08 thresholds are not agreed):
SIM_PROFILE=normal
# Defaults to SIM_INTERVAL_MS when omitted:
SIM_RETRY_MS=2000
SIM_REQUEST_TIMEOUT_MS=5000
